# Scout BAML CLI smoke test (example workflow)
#
# Copy/rename to .github/workflows/scout-cli-test.yml to enable.
# Requires OPENAI_API_KEY secret for fallback path; Claude CLI must be available
# on the runner (install step included below).

name: Scout CLI Smoke Test

on:
  push:
    branches: [main, develop]
  pull_request:
    branches: [main, develop]
  schedule:
    - cron: "0 6 * * 1" # Mondays at 06:00 UTC

jobs:
  scout-cli:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements-baml.txt

      - name: Install Claude CLI (replace with official installer for your runner)
        run: |
          echo "Install Claude CLI here (see https://claude.com/download)."
          echo "This placeholder avoids failing the sample workflow on GitHub runners."
          # claude --version

      - name: Run Scout smoke test
        env:
          OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
        run: |
          python tests/smoke_test_scout_cli.py

      - name: Upload artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: scout-cli-smoke-test
          path: .context-foundry/scout_cli_smoke_test.*
