/* Dark Mode Theme for CF Daemon TUI */

/* Global Styles */
Screen {
    background: #1e1e1e;
    color: #e0e0e0;
}

/* Headers */
.header {
    background: #2d2d30;
    color: #ffffff;
    text-align: center;
    padding: 1;
    margin-bottom: 1;
    text-style: bold;
}

.section-title {
    color: #4ec9b0;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 1;
}

/* Job Table */
DataTable {
    background: #252526;
    border: solid #3e3e42;
    height: 1fr;
}

DataTable > .datatable--header {
    background: #2d2d30;
    color: #4ec9b0;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #094771;
    color: #ffffff;
}

DataTable:focus > .datatable--cursor {
    background: #0e639c;
}

/* Metrics Panel */
MetricsPanel {
    background: #2d2d30;
    color: #d4d4d4;
    padding: 1;
    margin-bottom: 1;
    border: solid #3e3e42;
    text-align: center;
}

/* Input Fields */
Input {
    background: #3c3c3c;
    color: #ffffff;
    border: solid #3e3e42;
}

Input:focus {
    border: solid #007acc;
}

/* Buttons */
Button {
    background: #0e639c;
    color: #ffffff;
    border: none;
    margin: 0 1;
}

Button:hover {
    background: #1177bb;
}

Button.-primary {
    background: #0e639c;
}

Button.-default {
    background: #3e3e42;
}

/* Log Viewer */
RichLog {
    background: #1e1e1e;
    border: solid #3e3e42;
    height: 1fr;
    scrollbar-background: #2d2d30;
    scrollbar-color: #3e3e42;
}

#log-controls {
    background: #2d2d30;
    color: #d4d4d4;
    padding: 1;
    margin-bottom: 1;
}

/* Chat Area (Conversation Screen) */
#chat-area {
    width: 3fr;
    padding: 1;
}

#sidebar {
    width: 1fr;
    background: #252526;
    padding: 1;
    border-left: solid #3e3e42;
}

.sidebar-title {
    color: #4ec9b0;
    text-style: bold;
    margin-bottom: 1;
}

#input-area {
    margin-top: 1;
    height: 3;
}

#chat-input {
    width: 4fr;
}

#send-btn {
    width: auto;
}

/* Parameter Editor Dialog */
#param-editor-dialog {
    background: #2d2d30;
    border: thick #007acc;
    padding: 2;
    width: 80;
    height: auto;
}

#param-editor-dialog .title {
    color: #4ec9b0;
    text-style: bold;
    text-align: center;
    margin-bottom: 2;
}

#param-editor-dialog Input {
    margin-bottom: 1;
}

.button-row {
    margin-top: 2;
    align: center middle;
    height: 3;
}

/* Phase Pipeline */
PhasePipeline {
    background: #252526;
    border: solid #3e3e42;
    padding: 1;
    margin-bottom: 1;
    height: auto;
}

/* Footer */
Footer {
    background: #007acc;
    color: #ffffff;
}

/* Progress Indication */
ProgressBar {
    color: #4ec9b0;
}

ProgressBar > .bar--complete {
    color: #4ec9b0;
}

ProgressBar > .bar--incomplete {
    color: #3e3e42;
}

/* Status Colors */
.status-success {
    color: #4ec9b0;
}

.status-error {
    color: #f48771;
}

.status-warning {
    color: #dcdcaa;
}

.status-info {
    color: #9cdcfe;
}
