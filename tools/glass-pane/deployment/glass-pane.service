[Unit]
Description=Glass Pane Dashboard - Context Foundry Build Monitor
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/glass-pane/backend
Environment="PATH=/opt/glass-pane/venv/bin"
EnvironmentFile=/opt/glass-pane/.env.production
ExecStart=/opt/glass-pane/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 2

# Restart configuration
Restart=always
RestartSec=10
StartLimitInterval=200
StartLimitBurst=5

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=glass-pane

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/glass-pane
ReadOnlyPaths=/home

[Install]
WantedBy=multi-user.target
