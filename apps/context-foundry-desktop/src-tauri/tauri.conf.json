{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Context Foundry",
  "version": "0.1.0",
  "identifier": "com.contextfoundry.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "",
    "frontendDist": "../dashboard-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Context Foundry",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8420 http://localhost:8420 http://127.0.0.1:8421 http://localhost:8421; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "category": "DeveloperTool",
    "shortDescription": "Visual dashboard for Context Foundry Daemon",
    "longDescription": "Context Foundry Desktop provides a visual interface for managing and monitoring Context Foundry build jobs, viewing metrics, and controlling the CF Daemon.",
    "copyright": "Copyright 2024 Context Foundry",
    "macOS": {
      "entitlements": "entitlements.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signingIdentity": "Developer ID Application: FOZBE LLC (CP39A5FC6V)",
      "providerShortName": "CP39A5FC6V"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
