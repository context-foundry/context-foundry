{
  "name": "TestRobloxGame",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$path": "src/ReplicatedStorage",

      "Remotes": {
        "$className": "Folder",

        "TestEvent": {
          "$className": "RemoteEvent"
        }
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$path": "src/ServerScriptService"
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FilteringEnabled": true
      },
      "$path": "src/Workspace",

      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Size": [200, 10, 200],
          "Position": [0, -5, 0],
          "BrickColor": "Bright green"
        }
      },

      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Size": [6, 1, 6],
          "Position": [0, 0.5, 0],
          "BrickColor": "Bright blue",
          "Duration": 0
        }
      }
    }
  }
}
