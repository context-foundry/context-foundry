{
  "version": "2.0.0",
  "last_updated": "2025-12-11",
  "project_type": "workday-extend",
  "total_builds": 0,
  "source": "ArcaneAuditor 42 rules + Context Foundry learnings",
  "patterns": [
    {
      "id": "extend-enabled-string-vs-boolean",
      "error_pattern": "enabled.*true|enabled.*false",
      "description": "The 'enabled' property must be a STRING ('true' or 'false'), not a boolean",
      "solution": "Change `\"enabled\": true` to `\"enabled\": \"true\"`",
      "severity": "high",
      "frequency": 1,
      "first_seen": "2025-12-10",
      "last_seen": "2025-12-10",
      "example_bad": "{ \"type\": \"text\", \"enabled\": true }",
      "example_good": "{ \"type\": \"text\", \"enabled\": \"true\" }"
    },
    {
      "id": "extend-visible-boolean-not-string",
      "error_pattern": "visible.*\"true\"|visible.*\"false\"",
      "description": "The 'visible' property must be a BOOLEAN (true or false), not a string",
      "solution": "Change `\"visible\": \"true\"` to `\"visible\": true` or use expression `\"visible\": \"<% condition %>\"`",
      "severity": "high",
      "frequency": 1,
      "first_seen": "2025-12-10",
      "last_seen": "2025-12-10",
      "example_bad": "{ \"type\": \"section\", \"visible\": \"true\" }",
      "example_good": "{ \"type\": \"section\", \"visible\": true }"
    },
    {
      "id": "extend-empty-object-syntax",
      "error_pattern": "\\{\\s*\\}",
      "description": "Empty objects in Extend expressions must use {:} syntax, not {}",
      "solution": "Change `{}` to `{:}` for empty objects in expressions",
      "severity": "medium",
      "frequency": 1,
      "first_seen": "2025-12-10",
      "last_seen": "2025-12-10",
      "example_bad": "<% self.data = {}; %>",
      "example_good": "<% self.data = {:}; %>"
    },
    {
      "id": "extend-missing-invoke-deferred",
      "error_pattern": "deferred.*true.*endpoint\\.data",
      "description": "Deferred endpoints must be called with .invoke() - they don't auto-execute",
      "solution": "Use `endpoint.invoke()` to call deferred endpoints manually",
      "severity": "high",
      "frequency": 1,
      "first_seen": "2025-12-10",
      "last_seen": "2025-12-10",
      "example_bad": "<% resultsSection.data = myEndpoint.data; %>",
      "example_good": "<% pageVariables.result = myEndpoint.invoke(); resultsSection.data = pageVariables.result; %>"
    },
    {
      "id": "extend-parameter-bindings-overwrite",
      "error_pattern": "parameters.*parameterBindings",
      "description": "parameterBindings overwrites parameters if both are present",
      "solution": "Use either 'parameters' or 'parameterBindings', not both",
      "severity": "medium",
      "frequency": 1,
      "first_seen": "2025-12-10",
      "last_seen": "2025-12-10",
      "example_bad": "{ \"taskReference\": { \"taskId\": \"page\", \"parameters\": {...}, \"parameterBindings\": {...} } }",
      "example_good": "{ \"taskReference\": { \"taskId\": \"page\", \"parameterBindings\": { \"id\": \"<% item.id %>\" } } }"
    },
    {
      "id": "extend-missing-return-onsend",
      "error_pattern": "onSend.*self\\.data.*(?!return)",
      "description": "The onSend expression must return self.data",
      "solution": "Always add `return self.data;` at the end of onSend expressions",
      "severity": "high",
      "frequency": 1,
      "first_seen": "2025-12-10",
      "last_seen": "2025-12-10",
      "example_bad": "<% self.data = {:}; self.data.query = input.getValue(); %>",
      "example_good": "<% self.data = {:}; self.data.query = input.getValue(); return self.data; %>"
    },
    {
      "id": "extend-missing-null-handling",
      "error_pattern": "endpoint\\.data\\.[a-zA-Z]+(?!\\s*\\?\\?)",
      "description": "Missing null handling on data access can crash the entire page if data not found",
      "solution": "Use ?? with empty string or default value for any data that might be null",
      "severity": "high",
      "frequency": 1,
      "first_seen": "2025-12-10",
      "last_seen": "2025-12-10",
      "example_bad": "<% endpoint.data.keyboardType.descriptor %>",
      "example_good": "<% endpoint.data.keyboardType.descriptor ?? '' %>"
    },
    {
      "id": "extend-grid-missing-row-variable",
      "error_pattern": "type.*grid.*rows.*(?!rowVariableName)",
      "description": "Grid widgets need rowVariableName to access row data in columns",
      "solution": "Add rowVariableName to grid and use it in cellTemplate expressions",
      "severity": "high",
      "frequency": 1,
      "first_seen": "2025-12-10",
      "last_seen": "2025-12-10",
      "example_bad": "{ \"type\": \"grid\", \"rows\": \"<% items %>\" }",
      "example_good": "{ \"type\": \"grid\", \"rows\": \"<% items %>\", \"rowVariableName\": \"item\" }"
    },
    {
      "id": "extend-missing-failonstatuscodes",
      "error_pattern": "endPoints.*name.*url.*(?!failOnStatusCodes)",
      "description": "Endpoints without failOnStatusCodes silently swallow 4xx errors",
      "solution": "Always add failOnStatusCodes: [{code: 400}, {code: 403}] to endpoints",
      "severity": "high",
      "frequency": 1,
      "first_seen": "2025-12-11",
      "last_seen": "2025-12-11",
      "example_bad": "{ \"name\": \"getWorker\", \"url\": \"/workers/me\" }",
      "example_good": "{ \"name\": \"getWorker\", \"url\": \"/workers/me\", \"failOnStatusCodes\": [{\"code\": 400}, {\"code\": 403}] }"
    },
    {
      "id": "extend-missing-security-domains",
      "error_pattern": "\"id\".*\"presentation\".*(?!securityDomains)",
      "description": "PMD pages without securityDomains are accessible to all users",
      "solution": "Add securityDomains array to control page access",
      "severity": "high",
      "frequency": 1,
      "first_seen": "2025-12-11",
      "last_seen": "2025-12-11",
      "example_bad": "{ \"id\": \"myPage\", \"presentation\": {...} }",
      "example_good": "{ \"id\": \"myPage\", \"securityDomains\": [\"ViewAdminPages\"], \"presentation\": {...} }"
    },
    {
      "id": "extend-missing-widget-id",
      "error_pattern": "\"type\":\\s*\"[^\"]+\"[^}]*(?!\"id\")",
      "description": "Widgets without id cannot be referenced in scripts",
      "solution": "Add id property to every widget (except footer, item, group, title, pod, card)",
      "severity": "high",
      "frequency": 1,
      "first_seen": "2025-12-11",
      "last_seen": "2025-12-11",
      "example_bad": "{ \"type\": \"richText\", \"label\": \"Welcome\" }",
      "example_good": "{ \"type\": \"richText\", \"id\": \"welcomeMessage\", \"label\": \"Welcome\" }"
    },
    {
      "id": "extend-hardcoded-workday-url",
      "error_pattern": "workday\\.com",
      "description": "Hardcoded workday.com URLs are not update safe or region aware",
      "solution": "Use apiGatewayEndpoint or baseUrlType instead",
      "severity": "high",
      "frequency": 1,
      "first_seen": "2025-12-11",
      "last_seen": "2025-12-11",
      "example_bad": "\"url\": \"https://api.workday.com/common/v1/workers\"",
      "example_good": "\"url\": \"<% apiGatewayEndpoint + '/common/v1/workers' %>\""
    },
    {
      "id": "extend-iscollection-performance",
      "error_pattern": "isCollection.*true",
      "description": "isCollection: true causes severe performance degradation",
      "solution": "Remove isCollection, use WQL or RaaS for large datasets",
      "severity": "high",
      "frequency": 1,
      "first_seen": "2025-12-11",
      "last_seen": "2025-12-11",
      "example_bad": "{ \"name\": \"getWorkers\", \"isCollection\": true }",
      "example_good": "{ \"name\": \"getWorkers\" }"
    },
    {
      "id": "extend-besteffort-swallows-errors",
      "error_pattern": "bestEffort.*true",
      "description": "bestEffort: true silently swallows API failures",
      "solution": "Remove bestEffort property to let failures bubble up",
      "severity": "high",
      "frequency": 1,
      "first_seen": "2025-12-11",
      "last_seen": "2025-12-11",
      "example_bad": "{ \"name\": \"saveData\", \"bestEffort\": true }",
      "example_good": "{ \"name\": \"saveData\" }"
    },
    {
      "id": "extend-session-variable-memory-leak",
      "error_pattern": "variableScope.*session",
      "description": "Session-scoped variables cause memory leaks - persist until logout",
      "solution": "Use variableScope: flow instead",
      "severity": "high",
      "frequency": 1,
      "first_seen": "2025-12-11",
      "last_seen": "2025-12-11",
      "example_bad": "{ \"type\": \"outboundVariable\", \"variableScope\": \"session\" }",
      "example_good": "{ \"type\": \"outboundVariable\", \"variableScope\": \"flow\" }"
    },
    {
      "id": "extend-console-log-in-production",
      "error_pattern": "console\\.(log|debug|info|warn|error)",
      "description": "Console statements expose data in production logs",
      "solution": "Remove all console statements before production",
      "severity": "high",
      "frequency": 1,
      "first_seen": "2025-12-11",
      "last_seen": "2025-12-11",
      "example_bad": "<% console.log('Processing:', data); %>",
      "example_good": "<% // Remove console statements %>"
    },
    {
      "id": "extend-grid-paging-sortable-conflict",
      "error_pattern": "autoPaging.*sortableAndFilterable|pagingInfo.*sortableAndFilterable",
      "description": "Combining paging with sortableAndFilterable causes severe performance issues",
      "solution": "Use either paging OR sortableAndFilterable, not both",
      "severity": "high",
      "frequency": 1,
      "first_seen": "2025-12-11",
      "last_seen": "2025-12-11",
      "example_bad": "{ \"type\": \"grid\", \"autoPaging\": true, \"columns\": [{\"sortableAndFilterable\": true}] }",
      "example_good": "{ \"type\": \"grid\", \"columns\": [{\"sortableAndFilterable\": true}] }"
    },
    {
      "id": "extend-var-instead-of-let-const",
      "error_pattern": "\\bvar\\s+[a-zA-Z_]",
      "description": "var has function scope which can cause bugs - use let/const instead",
      "solution": "Use const for immutable values, let for mutable",
      "severity": "medium",
      "frequency": 1,
      "first_seen": "2025-12-11",
      "last_seen": "2025-12-11",
      "example_bad": "<% var myVariable = 'value'; %>",
      "example_good": "<% const myVariable = 'value'; %>"
    },
    {
      "id": "extend-nested-array-search-performance",
      "error_pattern": "\\.(map|forEach|filter).*\\.(find|filter)",
      "description": "Nested array searches cause O(n^2) performance - can crash with large data",
      "solution": "Use list:toMap for O(1) lookups instead",
      "severity": "high",
      "frequency": 1,
      "first_seen": "2025-12-11",
      "last_seen": "2025-12-11",
      "example_bad": "<% workers.map(w => orgs.find(o => o.id == w.orgId)) %>",
      "example_good": "<% const orgById = list:toMap(orgs, 'id'); workers.map(w => orgById[w.orgId]) %>"
    },
    {
      "id": "extend-hardcoded-wid",
      "error_pattern": "'[a-f0-9]{32}'|\"[a-f0-9]{32}\"",
      "description": "Hardcoded WIDs break in different environments",
      "solution": "Store WIDs in app attributes",
      "severity": "medium",
      "frequency": 1,
      "first_seen": "2025-12-11",
      "last_seen": "2025-12-11",
      "example_bad": "WHERE country = 'd9e41a8c446c11de98360015c5e6daf6'",
      "example_good": "WHERE country = appAttr.usaCountryWid"
    },
    {
      "id": "extend-hardcoded-applicationid",
      "error_pattern": "'[a-zA-Z]+_[a-z]{6}'|\"[a-zA-Z]+_[a-z]{6}\"",
      "description": "Hardcoded applicationId breaks in different tenants",
      "solution": "Use site.applicationId instead",
      "severity": "medium",
      "frequency": 1,
      "first_seen": "2025-12-11",
      "last_seen": "2025-12-11",
      "example_bad": "const appId = 'acmeCorp_speedy';",
      "example_good": "const appId = site.applicationId;"
    },
    {
      "id": "extend-single-letter-array-param",
      "error_pattern": "\\.(map|filter|find|forEach|reduce)\\s*\\(\\s*[a-z]\\s*=>",
      "description": "Single-letter parameters in array methods are hard to read",
      "solution": "Use descriptive names like user, item, order",
      "severity": "low",
      "frequency": 1,
      "first_seen": "2025-12-11",
      "last_seen": "2025-12-11",
      "example_bad": "<% users.filter(x => x.active) %>",
      "example_good": "<% users.filter(user => user.active) %>"
    },
    {
      "id": "extend-magic-numbers",
      "error_pattern": "if\\s*\\([^)]*[0-9]{2,}[^)]*\\)|>\\s*[0-9]{2,}|<\\s*[0-9]{2,}",
      "description": "Magic numbers hide meaning and are hard to maintain",
      "solution": "Use named constants instead",
      "severity": "low",
      "frequency": 1,
      "first_seen": "2025-12-11",
      "last_seen": "2025-12-11",
      "example_bad": "<% if (price > 1000) { return price * 0.15; } %>",
      "example_good": "<% const premiumThreshold = 1000; const discount = 0.15; if (price > premiumThreshold) { return price * discount; } %>"
    },
    {
      "id": "extend-string-concat-instead-of-template",
      "error_pattern": "[\"']\\s*\\+\\s*[a-zA-Z_]|[a-zA-Z_]\\s*\\+\\s*[\"']",
      "description": "String concatenation is error-prone - use template literals",
      "solution": "Use template literal syntax with {{variable}}",
      "severity": "low",
      "frequency": 1,
      "first_seen": "2025-12-11",
      "last_seen": "2025-12-11",
      "example_bad": "<% 'Hello ' + userName + '!' %>",
      "example_good": "<% `Hello {{userName}}!` %>"
    },
    {
      "id": "extend-verbose-boolean-check",
      "error_pattern": "==\\s*(true|false)|!=\\s*(true|false)",
      "description": "Verbose boolean checks are unnecessary",
      "solution": "Use concise boolean expressions",
      "severity": "low",
      "frequency": 1,
      "first_seen": "2025-12-11",
      "last_seen": "2025-12-11",
      "example_bad": "<% if (user.active == true) %>",
      "example_good": "<% if (user.active) %>"
    },
    {
      "id": "extend-embedded-base64-image",
      "error_pattern": "data:image/[^;]+;base64",
      "description": "Base64 images bloat file size and slow page load",
      "solution": "Use external image URLs instead",
      "severity": "medium",
      "frequency": 1,
      "first_seen": "2025-12-11",
      "last_seen": "2025-12-11",
      "example_bad": "\"url\": \"data:image/png;base64,iVBORw0KGgo...\"",
      "example_good": "\"url\": \"https://example.com/images/logo.png\""
    },
    {
      "id": "extend-multiple-interpolators",
      "error_pattern": "<%[^%]*%>[^<]*<%",
      "description": "Multiple interpolators are harder to read than single template",
      "solution": "Use single interpolator with template literal",
      "severity": "low",
      "frequency": 1,
      "first_seen": "2025-12-11",
      "last_seen": "2025-12-11",
      "example_bad": "\"value\": \"Name: <% name %> Age: <% age %>\"",
      "example_good": "\"value\": \"<% `Name: {{name}} Age: {{age}}` %>\""
    },
    {
      "id": "extend-onload-endpoint-invoke",
      "error_pattern": "onLoad.*endpoint.*invoke",
      "description": "onLoad runs AFTER endpoints load - data is already available",
      "solution": "Access endpoint.data directly in onLoad, don't invoke()",
      "severity": "medium",
      "frequency": 1,
      "first_seen": "2025-12-10",
      "last_seen": "2025-12-10",
      "example_bad": "<% var data = myEndpoint.invoke(); %>",
      "example_good": "<% pageVariables.result = myEndpoint.data; %>"
    },
    {
      "id": "extend-single-tab",
      "error_pattern": "tabs.*\\[\\s*\\{[^\\]]*\\}\\s*\\]",
      "description": "Tabs must have at least 2 tabs - single tab breaks the template",
      "solution": "Always include 2 or more tabs, or don't use tabs at all",
      "severity": "high",
      "frequency": 1,
      "first_seen": "2025-12-10",
      "last_seen": "2025-12-10",
      "example_bad": "\"tabs\": [{ \"type\": \"section\", \"label\": \"Only Tab\" }]",
      "example_good": "\"tabs\": [{ \"type\": \"section\", \"label\": \"Tab 1\" }, { \"type\": \"section\", \"label\": \"Tab 2\" }]"
    },
    {
      "id": "extend-onsend-selfdata-antipattern",
      "error_pattern": "self\\.data\\s*=\\s*\\{:",
      "description": "Using self.data as temporary storage in onSend is an anti-pattern",
      "solution": "Use local variable instead of polluting self reference",
      "severity": "low",
      "frequency": 1,
      "first_seen": "2025-12-11",
      "last_seen": "2025-12-11",
      "example_bad": "<% self.data = {:}; self.data.foo = bar; return self.data; %>",
      "example_good": "<% let postData = {:}; postData.foo = bar; return postData; %>"
    }
  ]
}
