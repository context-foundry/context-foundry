{
  "version": "1.0.0",
  "description": "Quality validation checklist for Workday Extend apps. Based on ArcaneAuditor's 42 rules.",
  "usage": "Test agent should validate built apps against these rules before marking build as complete.",
  "rules": {
    "action_rules": {
      "description": "MUST FIX - These rules catch critical issues",
      "rules": [
        {
          "id": "EndpointFailOnStatusCodes",
          "category": "endpoint",
          "applies_to": ["pmd", "pod"],
          "check": "Every endpoint must have failOnStatusCodes with at least [400, 403]",
          "pattern_bad": "endpoint without failOnStatusCodes property",
          "pattern_good": "failOnStatusCodes: [{code: 400}, {code: 403}]",
          "validation": {
            "type": "json_property_required",
            "path": "$.endPoints[*]",
            "required_property": "failOnStatusCodes"
          }
        },
        {
          "id": "PMDSecurityDomain",
          "category": "security",
          "applies_to": ["pmd"],
          "check": "Every PMD page must have securityDomains array (except microConclusion pages)",
          "pattern_bad": "PMD file without securityDomains property",
          "pattern_good": "securityDomains: [\"ViewAdminPages\"]",
          "validation": {
            "type": "json_property_required",
            "path": "$",
            "required_property": "securityDomains",
            "exceptions": ["presentation.microConclusion == true"]
          }
        },
        {
          "id": "WidgetIdRequired",
          "category": "widget",
          "applies_to": ["pmd", "pod"],
          "check": "Every widget must have an id property",
          "excluded_types": ["footer", "item", "group", "title", "pod", "cardContainer", "card", "instanceList", "taskReference", "editTasks", "multiSelectCalendar", "bpExtender", "hub"],
          "pattern_bad": "widget without id property",
          "pattern_good": "id: \"myWidgetId\"",
          "validation": {
            "type": "json_property_required",
            "path": "$..*[?(@.type)]",
            "required_property": "id"
          }
        },
        {
          "id": "HardcodedWorkdayAPI",
          "category": "security",
          "applies_to": ["pmd", "pod", "amd"],
          "check": "Never hardcode *.workday.com URLs",
          "pattern_bad": "url containing 'workday.com'",
          "pattern_good": "apiGatewayEndpoint + '/path'",
          "validation": {
            "type": "regex_forbidden",
            "pattern": "workday\\.com"
          }
        },
        {
          "id": "NoIsCollectionOnEndpoints",
          "category": "endpoint",
          "applies_to": ["pmd", "pod"],
          "check": "Never use isCollection: true on inbound endpoints",
          "pattern_bad": "isCollection: true",
          "pattern_good": "Remove isCollection, use WQL/RaaS instead",
          "validation": {
            "type": "json_property_forbidden",
            "path": "$.endPoints[*]",
            "forbidden_property": "isCollection",
            "forbidden_value": true
          }
        },
        {
          "id": "OnlyMaximumEffort",
          "category": "endpoint",
          "applies_to": ["pmd", "pod"],
          "check": "Never use bestEffort: true",
          "pattern_bad": "bestEffort: true",
          "pattern_good": "Remove bestEffort property",
          "validation": {
            "type": "json_property_forbidden",
            "path": "$.endPoints[*]",
            "forbidden_property": "bestEffort",
            "forbidden_value": true
          }
        },
        {
          "id": "NoPMDSessionVariables",
          "category": "endpoint",
          "applies_to": ["pmd"],
          "check": "Never use variableScope: session on outbound endpoints",
          "pattern_bad": "variableScope: \"session\"",
          "pattern_good": "variableScope: \"flow\"",
          "validation": {
            "type": "json_property_forbidden",
            "path": "$.outboundData.outboundEndpoints[*]",
            "forbidden_property": "variableScope",
            "forbidden_value": "session"
          }
        },
        {
          "id": "ScriptConsoleLog",
          "category": "script",
          "applies_to": ["pmd", "pod", "script"],
          "check": "No console.log/console.debug statements in production code",
          "pattern_bad": "console.log() or console.debug()",
          "pattern_good": "Remove console statements",
          "validation": {
            "type": "regex_forbidden",
            "pattern": "console\\.(log|debug|info|warn|error)\\s*\\("
          }
        },
        {
          "id": "GridPagingWithSortable",
          "category": "widget",
          "applies_to": ["pmd", "pod"],
          "check": "Never combine autoPaging with sortableAndFilterable columns",
          "pattern_bad": "autoPaging: true with sortableAndFilterable: true column",
          "pattern_good": "Use either paging OR sortableAndFilterable, not both",
          "validation": {
            "type": "custom",
            "description": "Check grids with autoPaging/pagingInfo don't have sortableAndFilterable columns"
          }
        },
        {
          "id": "ScriptEmptyFunction",
          "category": "script",
          "applies_to": ["pmd", "pod", "script"],
          "check": "No empty function bodies",
          "pattern_bad": "function() { }",
          "pattern_good": "Implement function or remove it",
          "validation": {
            "type": "regex_forbidden",
            "pattern": "function\\s*\\([^)]*\\)\\s*\\{\\s*\\}"
          }
        }
      ]
    },
    "advice_rules": {
      "description": "SHOULD FIX - Best practices for code quality",
      "rules": [
        {
          "id": "EndpointNameLowerCamelCase",
          "category": "naming",
          "applies_to": ["pmd", "pod"],
          "check": "Endpoint names must use lowerCamelCase",
          "pattern_bad": "get_user_data or GetUserData",
          "pattern_good": "getUserData",
          "validation": {
            "type": "naming_convention",
            "path": "$.endPoints[*].name",
            "convention": "lowerCamelCase"
          }
        },
        {
          "id": "EndpointBaseUrlType",
          "category": "endpoint",
          "applies_to": ["pmd", "pod"],
          "check": "Use baseUrlType instead of hardcoded apiGatewayEndpoint",
          "pattern_bad": "url: apiGatewayEndpoint + '/path'",
          "pattern_good": "baseUrlType: 'workday-common'",
          "validation": {
            "type": "regex_warn",
            "pattern": "apiGatewayEndpoint"
          }
        },
        {
          "id": "WidgetIdLowerCamelCase",
          "category": "naming",
          "applies_to": ["pmd", "pod"],
          "check": "Widget IDs must use lowerCamelCase",
          "pattern_bad": "WelcomeMessage or welcome_message",
          "pattern_good": "welcomeMessage",
          "validation": {
            "type": "naming_convention",
            "path": "$..*[?(@.id)].id",
            "convention": "lowerCamelCase"
          }
        },
        {
          "id": "FooterPodRequired",
          "category": "structure",
          "applies_to": ["pmd"],
          "check": "Footers should use pod structure for reusability",
          "pattern_bad": "footer with inline widgets",
          "pattern_good": "footer with pod child",
          "validation": {
            "type": "custom",
            "description": "Check footer has pod child type"
          }
        },
        {
          "id": "PMDSectionOrdering",
          "category": "structure",
          "applies_to": ["pmd"],
          "check": "PMD sections in order: id, securityDomains, include, script, endPoints, onSubmit, outboundData, onLoad, presentation",
          "pattern_bad": "presentation before id",
          "pattern_good": "Correct ordering",
          "validation": {
            "type": "json_key_order",
            "expected_order": ["id", "securityDomains", "include", "script", "endPoints", "onSubmit", "outboundData", "onLoad", "presentation"]
          }
        },
        {
          "id": "FileNameLowerCamelCase",
          "category": "naming",
          "applies_to": ["pmd", "pod", "script", "amd", "smd"],
          "check": "File names must use lowerCamelCase",
          "pattern_bad": "MyPage.pmd or my_page.pmd",
          "pattern_good": "myPage.pmd",
          "validation": {
            "type": "filename_convention",
            "convention": "lowerCamelCase"
          }
        },
        {
          "id": "ScriptVarUsage",
          "category": "script",
          "applies_to": ["pmd", "pod", "script"],
          "check": "Use let/const instead of var",
          "pattern_bad": "var myVariable = value",
          "pattern_good": "const myVariable = value",
          "validation": {
            "type": "regex_warn",
            "pattern": "\\bvar\\s+[a-zA-Z_]"
          }
        },
        {
          "id": "ScriptVariableNaming",
          "category": "naming",
          "applies_to": ["pmd", "pod", "script"],
          "check": "Variables must use lowerCamelCase",
          "pattern_bad": "user_name or UserName",
          "pattern_good": "userName",
          "validation": {
            "type": "regex_warn",
            "pattern": "(const|let|var)\\s+[A-Z_]|_[a-z]"
          }
        },
        {
          "id": "ScriptDescriptiveParameter",
          "category": "script",
          "applies_to": ["pmd", "pod", "script"],
          "check": "Use descriptive names in array methods, not single letters",
          "pattern_bad": "users.filter(x => x.active)",
          "pattern_good": "users.filter(user => user.active)",
          "validation": {
            "type": "regex_warn",
            "pattern": "\\.(map|filter|find|forEach|reduce)\\s*\\(\\s*[a-z]\\s*=>"
          }
        },
        {
          "id": "ScriptMagicNumber",
          "category": "script",
          "applies_to": ["pmd", "pod", "script"],
          "check": "Use named constants instead of magic numbers",
          "pattern_bad": "if (price > 1000)",
          "pattern_good": "const premiumThreshold = 1000; if (price > premiumThreshold)",
          "validation": {
            "type": "custom",
            "description": "Check for numeric literals in comparisons and calculations"
          }
        },
        {
          "id": "ScriptArrayMethodUsage",
          "category": "script",
          "applies_to": ["pmd", "pod", "script"],
          "check": "Use array methods instead of for loops",
          "pattern_bad": "for (let i = 0; i < items.length; i++)",
          "pattern_good": "items.map/filter/forEach",
          "validation": {
            "type": "regex_warn",
            "pattern": "for\\s*\\(\\s*(var|let)\\s+\\w+\\s*=\\s*0\\s*;\\s*\\w+\\s*<\\s*\\w+\\.length"
          }
        },
        {
          "id": "ScriptNestedArraySearch",
          "category": "script",
          "applies_to": ["pmd", "pod", "script"],
          "check": "Avoid nested array searches - use list:toMap",
          "pattern_bad": "workers.map(w => orgs.find(o => o.id == w.orgId))",
          "pattern_good": "const orgById = list:toMap(orgs, 'id')",
          "validation": {
            "type": "regex_warn",
            "pattern": "\\.(map|forEach|filter)\\([^)]*\\)\\s*=>\\s*[^)]*\\.(find|filter)\\("
          }
        },
        {
          "id": "ScriptStringConcat",
          "category": "script",
          "applies_to": ["pmd", "pod", "script"],
          "check": "Use template literals instead of string concatenation",
          "pattern_bad": "\"Hello \" + userName",
          "pattern_good": "`Hello {{userName}}`",
          "validation": {
            "type": "regex_warn",
            "pattern": "[\"']\\s*\\+\\s*[a-zA-Z_]|[a-zA-Z_]\\s*\\+\\s*[\"']"
          }
        },
        {
          "id": "ScriptVerboseBooleanCheck",
          "category": "script",
          "applies_to": ["pmd", "pod", "script"],
          "check": "Use concise boolean expressions",
          "pattern_bad": "if (user.active == true)",
          "pattern_good": "if (user.active)",
          "validation": {
            "type": "regex_warn",
            "pattern": "==\\s*(true|false)|!=\\s*(true|false)"
          }
        },
        {
          "id": "ScriptComplexity",
          "category": "script",
          "applies_to": ["pmd", "pod", "script"],
          "check": "Keep cyclomatic complexity under 10",
          "pattern_bad": "Function with >10 if/else/loop branches",
          "pattern_good": "Break into smaller functions",
          "validation": {
            "type": "complexity",
            "max_cyclomatic": 10
          }
        },
        {
          "id": "ScriptNestingLevel",
          "category": "script",
          "applies_to": ["pmd", "pod", "script"],
          "check": "Keep nesting under 4 levels",
          "pattern_bad": "if { if { if { if { if { } } } } }",
          "pattern_good": "Use early returns",
          "validation": {
            "type": "nesting",
            "max_level": 4
          }
        },
        {
          "id": "ScriptLongFunction",
          "category": "script",
          "applies_to": ["pmd", "script"],
          "check": "Keep functions under 50 lines",
          "pattern_bad": "Function > 50 lines",
          "pattern_good": "Break into smaller functions",
          "validation": {
            "type": "line_count",
            "max_lines": 50
          }
        },
        {
          "id": "ScriptLongBlock",
          "category": "script",
          "applies_to": ["pmd", "pod"],
          "check": "Keep embedded script blocks under 30 lines",
          "pattern_bad": "onLoad/onChange > 30 lines",
          "pattern_good": "Extract to functions in script section",
          "validation": {
            "type": "line_count",
            "max_lines": 30
          }
        },
        {
          "id": "ScriptFunctionParameterCount",
          "category": "script",
          "applies_to": ["pmd", "pod", "script"],
          "check": "Keep function parameters under 4",
          "pattern_bad": "function(a, b, c, d, e, f)",
          "pattern_good": "function(personalInfo, contactInfo)",
          "validation": {
            "type": "parameter_count",
            "max_parameters": 4
          }
        },
        {
          "id": "ScriptUnusedVariable",
          "category": "script",
          "applies_to": ["pmd", "pod", "script"],
          "check": "Remove unused variables",
          "pattern_bad": "const unused = 'value'; // never used",
          "pattern_good": "Only declare what's used",
          "validation": {
            "type": "custom",
            "description": "Track variable declarations and usages"
          }
        },
        {
          "id": "ScriptUnusedIncludes",
          "category": "script",
          "applies_to": ["pmd"],
          "check": "Remove unused script includes",
          "pattern_bad": "include: ['util.script', 'unused.script']",
          "pattern_good": "Only include what's called",
          "validation": {
            "type": "custom",
            "description": "Track include usage"
          }
        },
        {
          "id": "HardcodedApplicationId",
          "category": "security",
          "applies_to": ["pmd", "pod"],
          "check": "Use site.applicationId instead of hardcoded app IDs",
          "pattern_bad": "applicationId = 'acmeCorp_speedy'",
          "pattern_good": "applicationId = site.applicationId",
          "validation": {
            "type": "regex_warn",
            "pattern": "['\"][a-zA-Z]+_[a-z]{6}['\"]"
          }
        },
        {
          "id": "HardcodedWid",
          "category": "security",
          "applies_to": ["pmd", "pod"],
          "check": "Use app attributes instead of hardcoded WIDs",
          "pattern_bad": "'d9e41a8c446c11de98360015c5e6daf6'",
          "pattern_good": "appAttr.locationWid",
          "validation": {
            "type": "regex_warn",
            "pattern": "['\"][a-f0-9]{32}['\"]"
          }
        },
        {
          "id": "StringBoolean",
          "category": "structure",
          "applies_to": ["pmd", "pod"],
          "check": "Use actual booleans, not strings (except where Extend requires strings)",
          "pattern_bad": "visible: \"true\"",
          "pattern_good": "visible: true",
          "validation": {
            "type": "regex_warn",
            "pattern": ":\\s*[\"'](true|false)[\"']"
          }
        },
        {
          "id": "MultipleStringInterpolators",
          "category": "structure",
          "applies_to": ["pmd", "pod"],
          "check": "Use single template literal instead of multiple interpolators",
          "pattern_bad": "\"Name: <% name %> Age: <% age %>\"",
          "pattern_good": "\"<% `Name: {{name}} Age: {{age}}` %>\"",
          "validation": {
            "type": "regex_warn",
            "pattern": "<%[^%]*%>[^<]*<%"
          }
        },
        {
          "id": "EmbeddedImages",
          "category": "structure",
          "applies_to": ["pmd", "pod"],
          "check": "Don't embed base64 images",
          "pattern_bad": "url: \"data:image/png;base64,...\"",
          "pattern_good": "url: \"https://example.com/image.png\"",
          "validation": {
            "type": "regex_forbidden",
            "pattern": "data:image/[^;]+;base64"
          }
        },
        {
          "id": "ScriptOnSendSelfData",
          "category": "script",
          "applies_to": ["pmd"],
          "check": "In onSend, use local variables instead of self.data as temp storage",
          "pattern_bad": "self.data = {:}; self.data.foo = bar;",
          "pattern_good": "let postData = {:}; postData.foo = bar;",
          "validation": {
            "type": "regex_warn",
            "pattern": "self\\.data\\s*=\\s*\\{:"
          }
        }
      ]
    }
  },
  "test_agent_instructions": {
    "overview": "When validating a built Workday Extend app, the Test agent should:",
    "steps": [
      {
        "step": 1,
        "action": "Scan all PMD, POD, and script files in the built app"
      },
      {
        "step": 2,
        "action": "Run ACTION rules first - these MUST pass for build to succeed"
      },
      {
        "step": 3,
        "action": "Run ADVICE rules - report warnings but don't fail build"
      },
      {
        "step": 4,
        "action": "Generate quality report with findings"
      },
      {
        "step": 5,
        "action": "If ACTION violations found, fix them and re-test"
      }
    ],
    "passing_criteria": {
      "action_rules": "All must pass (0 violations)",
      "advice_rules": "Warnings acceptable but should be minimized"
    }
  }
}
