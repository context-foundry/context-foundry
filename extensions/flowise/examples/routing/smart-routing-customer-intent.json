    {
      "id": "classifier_intent",
      "type": "agentFlow",
      "position": {
        "x": -150,
        "y": 200
      },
      "data": {
        "id": "classifier_intent",
        "label": "Intent Classifier",
        "version": 1.1,
        "name": "conditionAgentAgentflow",
        "type": "ConditionAgent",
        "color": "#ff8fab",
        "baseClasses": [
          "ConditionAgent"
        ],
        "category": "Agent Flows",
        "description": "Classify customer intent into Sales/Support/Billing/General",
        "inputParams": [
          {
            "label": "Model",
            "name": "conditionAgentModel",
            "type": "asyncOptions",
            "loadMethod": "listModels",
            "loadConfig": true
          },
          {
            "label": "Instructions",
            "name": "conditionAgentInstructions",
            "type": "string",
            "rows": 4,
            "placeholder": "Analyze the user input and route to the appropriate agent..."
          },
          {
            "label": "Input",
            "name": "conditionAgentInput",
            "type": "string",
            "acceptVariable": true
          },
          {
            "label": "Scenarios",
            "name": "conditionAgentScenarios",
            "type": "array",
            "array": [
              {
                "label": "Scenario",
                "name": "scenario",
                "type": "string",
                "rows": 2
              }
            ]
          }
        ],
        "inputAnchors": [],
        "inputs": {
          "conditionAgentModel": "chatAnthropic",
          "conditionAgentInstructions": "You are a customer intent classifier. Analyze the customer message and classify their PRIMARY intent into exactly ONE of these categories:\n\n1. **Sales** - Customer wants to:\n   - Learn about products or services\n   - Get pricing information\n   - Request a demo or trial\n   - Discuss purchasing or upgrades\n   - Keywords: price, pricing, demo, trial, buy, purchase, upgrade, features, compare\n\n2. **Support** - Customer needs:\n   - Help with existing product issues\n   - Troubleshooting or error resolution\n   - How-to guidance\n   - Technical assistance\n   - Keywords: error, not working, help, how do I, issue, problem, broken, fix\n\n3. **Billing** - Customer has questions about:\n   - Invoices or statements\n   - Payments or charges\n   - Subscriptions or renewals\n   - Refunds or credits\n   - Keywords: invoice, payment, charge, bill, subscription, refund, cancel\n\n4. **General** - Use this when:\n   - Intent is unclear or ambiguous\n   - Message doesn't fit other categories\n   - Multiple intents with no clear primary\n   - General feedback or greetings\n\nIMPORTANT: Choose the MOST RELEVANT single category. When in doubt, choose General.\n\nOutput your classification with confidence (0.0-1.0) and brief reasoning.",
          "conditionAgentInput": "{{ question }}",
          "conditionAgentScenarios": [
            {
              "scenario": "Sales - Customer interested in purchasing, pricing, demos, or product information"
            },
            {
              "scenario": "Support - Customer needs help with existing product, troubleshooting, or technical issues"
            },
            {
              "scenario": "Billing - Customer has questions about invoices, payments, subscriptions, or charges"
            },
            {
              "scenario": "General - Unclear intent, general inquiries, feedback, or doesn't fit other categories"
            }
          ],
          "conditionAgentModelConfig": {
            "credential": "Anthropic API Key",
            "modelName": "claude-sonnet-4-5-20250929",
            "temperature": 0.1,
            "streaming": true,
            "conditionAgentModel": "chatAnthropic"
          }
        },
        "outputAnchors": [
          {
            "id": "classifier_intent-output-0",
            "label": 0,
            "name": 0,
            "description": "Sales"
          },
          {
            "id": "classifier_intent-output-1",
            "label": 1,
            "name": 1,
            "description": "Support"
          },
          {
            "id": "classifier_intent-output-2",
            "label": 2,
            "name": 2,
            "description": "Billing"
          },
          {
            "id": "classifier_intent-output-3",
            "label": 3,
            "name": 3,
            "description": "General"
          }
        ],
        "outputs": {}
      },
      "width": 221,
      "height": 100
    },
