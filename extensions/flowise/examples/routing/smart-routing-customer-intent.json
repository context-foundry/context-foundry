        "id": "agent_synthesizer",
        "label": "Response Synthesizer",
        "version": 2.2,
        "name": "agentAgentflow",
        "type": "Agent",
        "color": "#66BB6A",
        "baseClasses": [
          "Agent"
        ],
        "category": "Agent Flows",
        "description": "Synthesizes and returns the routed agent's response",
        "inputParams": [
          {
            "label": "Model",
            "name": "agentModel",
            "type": "asyncOptions",
            "loadMethod": "listModels",
            "loadConfig": true
          },
          {
            "label": "System Message",
            "name": "agentSystemMessage",
            "type": "string",
            "rows": 4,
            "optional": true
          },
          {
            "label": "Tools",
            "name": "agentTools",
            "type": "array",
            "optional": true
          },
          {
            "label": "Enable Memory",
            "name": "agentEnableMemory",
            "type": "boolean",
            "default": false,
            "optional": true
          },
          {
            "label": "Update State",
            "name": "agentStateUpdates",
            "type": "array",
            "optional": true
          }
        ],
        "inputAnchors": [],
        "inputs": {
          "agentModel": "chatAnthropic",
          "agentSystemMessage": "You are a response formatter for the Customer Intent Router.\n\nYour task is simple: Read the response from the specialist agent that was routed to and return it to the user.\n\nCheck $flow.state for these possible responses (only ONE will be populated):\n- $flow.state.sales.response (if Sales agent handled it)\n- $flow.state.support.response (if Support agent handled it)\n- $flow.state.billing.response (if Billing agent handled it)\n- $flow.state.general.response (if General agent handled it)\n\nReturn the populated response directly to the user. Do not add any additional commentary or formatting - just pass through the specialist's response as-is.\n\nIf for some reason no response is found in state, apologize and ask the user to try again.",
          "agentTools": [],
          "agentEnableMemory": false,
          "agentStateUpdates": [
            {
              "key": "synthesized.complete",
              "value": "true"
            }
          ],
          "agentModelConfig": {
            "credential": "Anthropic API Key",
            "modelName": "claude-sonnet-4-5-20250929",
            "temperature": 0.1,
            "streaming": true,
            "agentModel": "chatAnthropic"
          }
        },
        "outputAnchors": [
          {
            "id": "agent_synthesizer-output-agentAgentflow",
            "label": "Agent",
            "name": "agentAgentflow"
          }
        ],
        "outputs": {}
      },
      "width": 221,
      "height": 80
    },
