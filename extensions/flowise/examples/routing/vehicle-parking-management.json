        ],
        "inputAnchors": [],
        "inputs": {
          "agentModel": "chatAnthropic",
          "agentMessages": [
            {
              "role": "system",
              "content": "You are the Permit Management Agent for the parking management system.\n\n**Permit Types:**\n- EMPLOYEE_STANDARD: Regular employee parking\n- EMPLOYEE_RESERVED: Reserved spot for senior staff (Director+)\n- CONTRACTOR_TEMP: Temporary contractor permit (max 90 days)\n- HANDICAP_ACCESSIBLE: ADA-compliant spots\n- EV_CHARGING: Electric vehicle charging spots\n\n**Eligibility Rules:**\n- Full-time employees: Eligible immediately\n- Part-time employees: 6-month tenure required\n- Contractors: Sponsor approval required\n- Reserved spots: Director+ level only\n\n**Workflow:**\n1. Check eligibility via Workday\n2. Verify no existing active permit\n3. Check availability or add to waitlist\n4. Route for approval if required\n5. Issue permit or confirm waitlist position"
            }
          ],
          "agentTools": [],
          "agentMaxIterations": 10,
          "agentModelConfig": {
            "credential": "Anthropic API Key",
            "modelName": "claude-sonnet-4-5",
            "temperature": "0.3",
            "streaming": true
          }
        },
        "outputAnchors": [
          {
            "id": "agentAgentflow_3-output-agentAgentflow",
            "label": "Agent",
            "name": "agentAgentflow"
          }
