      "type": "agentFlow",
      "data": {
        "id": "agentAgentflow_2",
        "label": "Vehicle Registration",
        "version": 2.2,
        "name": "agentAgentflow",
        "type": "Agent",
        "color": "#4DD0E1",
        "baseClasses": ["Agent"],
        "category": "Agent Flows",
        "description": "Handles vehicle registration, updates, validation, and VIN capture",
        "inputParams": [
          {
            "label": "Model",
            "name": "agentModel",
            "type": "asyncOptions",
            "loadMethod": "listModels",
            "loadConfig": true,
            "id": "agentAgentflow_2-input-agentModel-asyncOptions",
            "display": true
          },
          {
            "label": "Messages",
            "name": "agentMessages",
            "type": "array",
            "optional": true,
            "acceptVariable": true,
            "array": [
              {
                "label": "Role",
                "name": "role",
                "type": "options",
                "options": [
                  {"label": "System", "name": "system"},
                  {"label": "Assistant", "name": "assistant"},
                  {"label": "User", "name": "user"}
                ]
              },
              {
                "label": "Content",
                "name": "content",
                "type": "string",
                "acceptVariable": true,
                "rows": 4
              }
            ],
            "id": "agentAgentflow_2-input-agentMessages-array",
            "display": true
          },
          {
            "label": "Tools",
            "name": "agentTools",
            "type": "Tool",
            "list": true,
            "optional": true,
            "id": "agentAgentflow_2-input-agentTools-Tool",
            "display": true
          },
          {
            "label": "Max Iterations",
            "name": "agentMaxIterations",
            "type": "number",
            "optional": true,
            "default": 10,
            "id": "agentAgentflow_2-input-agentMaxIterations-number",
            "display": true
          }
        ],
        "inputAnchors": [],
        "inputs": {
          "agentModel": "chatAnthropic",
          "agentMessages": [
            {
              "role": "system",
              "content": "You are the Vehicle Registration Agent for the parking management system.\n\n**Capabilities:**\n- Register new vehicles (license plate, make, model, year, color, VIN)\n- Update existing vehicle information\n- Validate license plate formats (state-specific)\n- Capture and verify VIN numbers (17 characters, checksum validation)\n- Manage insurance document uploads\n- Link vehicles to employee/contractor profiles via Workday\n\n**Rules:**\n- Maximum 2 vehicles per employee, 1 per contractor\n- License plates must be unique in system\n- Insurance documents required for all vehicles\n- VIN must be 17 characters and pass checksum\n\n**Process:**\n1. Verify user identity via Workday API\n2. Validate all vehicle information\n3. Check for duplicate registrations\n4. Store vehicle record in database\n5. Return confirmation with registration ID"
            }
          ],
          "agentTools": [],
          "agentMaxIterations": 10,
          "agentModelConfig": {
            "credential": "Anthropic API Key",
            "modelName": "claude-sonnet-4-5",
            "temperature": "0.3",
            "streaming": true
          }
        },
        "outputAnchors": [
          {
            "id": "agentAgentflow_2-output-agentAgentflow",
            "label": "Agent",
            "name": "agentAgentflow"
          }
        ],
        "outputs": {},
        "selected": false
      },
      "width": 220,
      "height": 160,
      "selected": false,
      "positionAbsolute": {
        "x": 600,
        "y": -100
      }
