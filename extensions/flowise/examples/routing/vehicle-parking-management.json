      "type": "agentFlow",
      "data": {
        "id": "conditionAgentAgentflow_1",
        "label": "Intent Router",
        "version": 1.1,
        "name": "conditionAgentAgentflow",
        "type": "ConditionAgent",
        "color": "#ff8fab",
        "baseClasses": ["ConditionAgent"],
        "category": "Agent Flows",
        "description": "Routes requests to appropriate specialized agent based on user intent",
        "inputParams": [
          {
            "label": "Model",
            "name": "conditionAgentModel",
            "type": "asyncOptions",
            "loadMethod": "listModels",
            "loadConfig": true,
            "id": "conditionAgentAgentflow_1-input-conditionAgentModel-asyncOptions",
            "display": true
          },
          {
            "label": "Instructions",
            "name": "conditionAgentInstructions",
            "type": "string",
            "description": "A general instructions of what the condition agent should do",
            "rows": 4,
            "acceptVariable": true,
            "placeholder": "Determine the user's intent for parking management",
            "id": "conditionAgentAgentflow_1-input-conditionAgentInstructions-string",
            "display": true
          },
          {
            "label": "Input",
            "name": "conditionAgentInput",
            "type": "string",
            "description": "Input to be used for the condition agent",
            "rows": 4,
            "acceptVariable": true,
            "default": "<p><span class=\"variable\" data-type=\"mention\" data-id=\"question\" data-label=\"question\">{{ question }}</span></p>",
            "id": "conditionAgentAgentflow_1-input-conditionAgentInput-string",
            "display": true
          },
          {
            "label": "Scenarios",
            "name": "conditionAgentScenarios",
            "description": "Define the scenarios that will be used as the conditions to split the flow",
            "type": "array",
            "array": [
              {
                "label": "Scenario",
                "name": "scenario",
                "type": "string",
                "placeholder": "User is asking about parking"
              }
            ],
            "default": [],
            "id": "conditionAgentAgentflow_1-input-conditionAgentScenarios-array",
            "display": true
          }
        ],
        "inputAnchors": [],
        "inputs": {
          "conditionAgentModel": "chatAnthropic",
          "conditionAgentInstructions": "<h2>Vehicle & Parking Management Router</h2><p>You are the intent classification router for the Vehicle Registration & Parking Management system. Analyze the user's request and route it to the appropriate specialized agent.</p><h3>Intent Categories</h3><ol><li><strong>VEHICLE_REGISTRATION</strong> - registering, updating, or validating vehicle information, license plates, VIN</li><li><strong>PERMIT_MANAGEMENT</strong> - applying for permits, checking eligibility, waitlist, renewals</li><li><strong>SPOT_BOOKING</strong> - reserving parking spots, canceling reservations, checking availability</li><li><strong>COMPLIANCE</strong> - insurance verification, violation checks, compliance status</li><li><strong>VISITOR_PERMIT</strong> - temporary permits for guests/visitors, QR codes</li><li><strong>REPORTING</strong> - occupancy, revenue, violation reports and analytics</li><li><strong>VIOLATION_MANAGEMENT</strong> - issuing, appealing, or resolving violations</li></ol><p>Be deterministic in your routing. If ambiguous, ask for clarification.</p>",
          "conditionAgentInput": "<p><span class=\"variable\" data-type=\"mention\" data-id=\"question\" data-label=\"question\">{{ question }}</span></p>",
          "conditionAgentScenarios": [
            {"scenario": "User is asking about vehicle registration, license plates, or VIN"},
            {"scenario": "User is asking about parking permits or eligibility"},
            {"scenario": "User is asking about booking or reserving parking spots"},
            {"scenario": "User is asking about compliance, insurance, or violations status"},
            {"scenario": "User is asking about visitor permits or guest passes"},
            {"scenario": "User is asking about reports or analytics"},
            {"scenario": "User is asking about violation management, appeals, or payments"}
          ],
          "conditionAgentModelConfig": {
            "credential": "Anthropic API Key",
            "modelName": "claude-sonnet-4-5",
            "temperature": "0.1",
            "streaming": true
          }
        },
        "outputAnchors": [
          {"id": "conditionAgentAgentflow_1-output-0", "label": 0, "name": 0, "description": "Vehicle Registration"},
          {"id": "conditionAgentAgentflow_1-output-1", "label": 1, "name": 1, "description": "Permit Management"},
          {"id": "conditionAgentAgentflow_1-output-2", "label": 2, "name": 2, "description": "Spot Booking"},
          {"id": "conditionAgentAgentflow_1-output-3", "label": 3, "name": 3, "description": "Compliance"},
          {"id": "conditionAgentAgentflow_1-output-4", "label": 4, "name": 4, "description": "Visitor Permit"},
          {"id": "conditionAgentAgentflow_1-output-5", "label": 5, "name": 5, "description": "Reporting"},
          {"id": "conditionAgentAgentflow_1-output-6", "label": 6, "name": 6, "description": "Violation Management"}
        ],
        "outputs": {
          "conditionAgentAgentflow": ""
        },
        "selected": false
