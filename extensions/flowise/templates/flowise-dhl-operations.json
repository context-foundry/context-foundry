          "conditionAgentModelConfig": {
            "modelName": "gpt-4o-mini",
            "temperature": 0.2,
            "streaming": true,
            "agentModel": "chatOpenAI"
          },
          "conditionAgentInstructions": "Analyze the user's DHL logistics question and route to the appropriate specialized agent.\n\nINTENT DETECTION KEYWORDS:\n- EXPRESS [0]: express, priority, overnight, same-day, urgent, time-sensitive, fast delivery\n- CUSTOMS [1]: customs, duty, tariff, import, export, documentation, HS code, clearance, international regulations\n- SUPPLY CHAIN [2]: supply chain, warehousing, inventory, distribution, fulfillment, logistics planning\n- FREIGHT [3]: freight, cargo, container, pallet, bulk shipment, air freight, ocean freight, ground transport\n- CUSTOMER SERVICE [4]: tracking, where is my package, delivery status, problem, claim, reroute, support\n- TECHNOLOGY [5]: tracking system, drone, automation, API, mobile app, MyDHL, digital platform\n- SUSTAINABILITY [6]: carbon footprint, green shipping, electric vehicle, sustainable, GoGreen, eco-friendly\n- GLOBAL OPS [7]: countries served, hub location, regional service, network coverage, general DHL information\n\nRULES:\n1. If multiple intents detected, choose PRIMARY intent\n2. Customer service queries (tracking, status, problems) → CUSTOMER SERVICE [4]\n3. Green/eco shipping options → SUSTAINABILITY [6], not FREIGHT [3]\n4. Technology/innovation questions → TECHNOLOGY [5]\n5. If unsure, route to GLOBAL OPS [7]",
          "conditionAgentScenarios": [
            {
              "scenario": "User is asking about express delivery, priority shipping, overnight, same-day, or time-sensitive shipments"
            },
            {
              "scenario": "User is asking about customs clearance, international regulations, duty, tariff, import/export documentation"
            },
            {
              "scenario": "User is asking about supply chain management, warehousing, inventory, distribution, or fulfillment"
            },
            {
              "scenario": "User is asking about freight transport, cargo shipping, containers, pallets, or bulk shipments"
            },
            {
              "scenario": "User is asking about shipment tracking, delivery status, customer support, claims, or problems"
            },
            {
              "scenario": "User is asking about tracking systems, drones, automation, APIs, mobile apps, or digital platforms"
            },
            {
              "scenario": "User is asking about carbon footprint, green shipping, electric vehicles, sustainability, or GoGreen program"
            },
            {
              "scenario": "User is asking about global coverage, hub locations, regional services, network information, or general DHL questions"
            }
          ]
        },
