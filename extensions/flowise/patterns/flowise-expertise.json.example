{
  "patterns": [
    {
      "pattern_id": "supervisor-worker-multi-agent",
      "category": "architecture",
      "description": "Multi-agent system with supervisor coordinating specialized worker agents",
      "applies_to": ["multi-agent", "complex-workflow", "workflow-orchestration"],
      "node_types": ["AgentExecutor", "LLMChain", "LLMRouterChain", "OpenAIFunctionsAgent"],
      "best_practices": [
        "Supervisor agent routes tasks to specialized workers based on task type",
        "Each worker has narrow, well-defined responsibility (single purpose)",
        "Shared memory enables context passing between supervisor and workers",
        "Error handling implemented at supervisor level to retry or reassign failed tasks",
        "Maximum 5 worker agents to avoid routing confusion",
        "Worker agents never call other workers directly (only through supervisor)",
        "Clear task decomposition in supervisor's system prompt",
        "Supervisor aggregates worker results before final response"
      ],
      "anti_patterns": [
        "Too many workers (>5) leads to routing confusion and increased latency",
        "Workers with overlapping responsibilities cause task assignment ambiguity",
        "No error recovery at worker level (supervisor must handle all failures)",
        "Circular dependencies where workers call each other",
        "Vague task descriptions in supervisor prompt",
        "No timeout on worker execution (can hang indefinitely)"
      ],
      "quality_markers": [
        "Clear task decomposition documented in system prompts",
        "Robust error handling with fallback strategies",
        "Efficient token usage (shared context, not redundant)",
        "Proper memory management (limited context window)",
        "Worker specialization clearly defined",
        "Supervisor routing logic is deterministic and testable"
      ],
      "example_config": {
        "supervisor": {
          "maxIterations": 10,
          "systemMessage": "You are a supervisor coordinating specialized workers. Route tasks to: SearchWorker (database queries), AnalyzeWorker (data analysis), FormatWorker (output formatting).",
          "tools": ["SearchWorker", "AnalyzeWorker", "FormatWorker"]
        },
        "worker": {
          "maxIterations": 5,
          "systemMessage": "You are SearchWorker. Your ONLY job is to search the database. Return results in JSON format.",
          "tools": ["database_search_tool"]
        }
      }
    },
    {
      "pattern_id": "rag-retrieval-augmented",
      "category": "architecture",
      "description": "RAG pattern with vector store, semantic retrieval, and optional reranking",
      "applies_to": ["rag", "knowledge-retrieval", "question-answering"],
      "node_types": ["VectorStoreRetriever", "OpenAIEmbeddings", "LLMChain", "ContextualCompressionRetriever"],
      "best_practices": [
        "Use hybrid search combining semantic (vector) and keyword (BM25) search",
        "Implement reranking (ContextualCompression) for better relevance",
        "Cache embeddings for frequently accessed documents (performance)",
        "Set appropriate chunk size: 512-1024 tokens for most use cases",
        "Return top-k=3-5 documents (balance between context and noise)",
        "Include source citations in LLM response for transparency",
        "Implement fallback response when no relevant documents found",
        "Monitor token usage to stay within context limits"
      ],
      "anti_patterns": [
        "Single-pass retrieval without reranking (lower relevance)",
        "Too large chunks (>2048 tokens) cause context overflow",
        "Too small chunks (<256 tokens) lose semantic meaning",
        "No fallback when retrieval returns empty results",
        "Not caching embeddings (performance degradation)",
        "Hardcoded top-k without testing (may miss relevant docs)",
        "No source attribution in responses (user trust issues)"
      ],
      "quality_markers": [
        "Hybrid search implementation (semantic + keyword)",
        "Reranking step for improved relevance",
        "Source citations included in responses",
        "Graceful handling of no-results case",
        "Embedding cache for performance",
        "Token usage monitoring and limits",
        "Document relevance scoring visible"
      ],
      "example_config": {
        "retriever": {
          "vectorStore": "Pinecone",
          "topK": 5,
          "searchType": "similarity",
          "filter": {}
        },
        "embeddings": {
          "model": "text-embedding-ada-002",
          "chunkSize": 1024,
          "chunkOverlap": 200
        },
        "llm_chain": {
          "systemMessage": "Answer the question using ONLY the provided context. Cite sources using [1], [2] format.",
          "temperature": 0.0,
          "maxTokens": 1000
        }
      }
    },
    {
      "pattern_id": "sequential-workflow",
      "category": "architecture",
      "description": "Sequential processing workflow with validation and error handling",
      "applies_to": ["workflow", "etl-pipeline", "data-processing"],
      "node_types": ["LLMChain", "Tool", "Output"],
      "best_practices": [
        "Each step has clear input/output contract (schema validation)",
        "Output validation before passing to next step",
        "Error handling and retry logic per step",
        "State persisted between steps (not just in memory)",
        "Idempotent operations (safe to retry without side effects)",
        "Progress tracking for long-running workflows",
        "Rollback capability for failed steps",
        "Timeout configured for each step"
      ],
      "anti_patterns": [
        "No validation between steps (garbage propagates)",
        "Non-idempotent operations (retry causes duplicates)",
        "No state persistence (restart loses all progress)",
        "Missing timeout (steps can hang indefinitely)",
        "No rollback mechanism (failed workflow leaves mess)",
        "Tightly coupled steps (can't test in isolation)"
      ],
      "quality_markers": [
        "Schema validation at step boundaries",
        "Idempotent design throughout",
        "State checkpointing for recovery",
        "Comprehensive error handling",
        "Step isolation for testing",
        "Progress visibility to users"
      ],
      "example_config": {
        "step": {
          "name": "extract_data",
          "timeout": 30000,
          "retries": 3,
          "validation": {
            "outputSchema": {"type": "object", "required": ["data"]}
          }
        }
      }
    },
    {
      "pattern_id": "conversational-chatbot",
      "category": "architecture",
      "description": "Chatbot with conversation memory and personality",
      "applies_to": ["chatbot", "assistant", "support-bot"],
      "node_types": ["ConversationChain", "BufferMemory", "ConversationSummaryMemory"],
      "best_practices": [
        "Memory configured (Buffer for short, Summary for long conversations)",
        "System prompt defines consistent personality and tone",
        "Input validation and sanitization (security)",
        "Output guardrails to prevent harmful content",
        "Session management (clear memory between users)",
        "Context window monitoring (summarize when approaching limit)",
        "Fallback responses for edge cases and errors",
        "User intent classification for routing"
      ],
      "anti_patterns": [
        "No memory (bot forgets context immediately)",
        "Unbounded memory (context window explosion)",
        "Inconsistent personality (tone varies randomly)",
        "No input sanitization (security vulnerability)",
        "Shared memory between users (privacy violation)",
        "No fallback for unhandled intents (poor UX)",
        "Ignoring context window limits (truncation errors)"
      ],
      "quality_markers": [
        "Consistent personality across conversations",
        "Proper memory management with limits",
        "Input validation and sanitization",
        "Graceful error handling",
        "Session isolation between users",
        "Context-aware responses",
        "Fallback responses defined"
      ],
      "example_config": {
        "memory": {
          "type": "ConversationSummaryMemory",
          "maxTokenLimit": 2000,
          "llm": "gpt-3.5-turbo"
        },
        "llm": {
          "systemMessage": "You are a helpful, friendly customer support assistant. Be concise and empathetic.",
          "temperature": 0.7
        }
      }
    },
    {
      "pattern_id": "error-handling-retry-pattern",
      "category": "reliability",
      "description": "Robust error handling with exponential backoff retry",
      "applies_to": ["all-flows"],
      "node_types": ["all"],
      "best_practices": [
        "Timeout configured for every external call (LLM, API, database)",
        "Retry logic with exponential backoff (1s, 2s, 4s, 8s)",
        "Maximum retry attempts defined (typically 3)",
        "Circuit breaker pattern for repeated failures",
        "Graceful degradation when retries exhausted",
        "User-friendly error messages (not stack traces)",
        "Logging for debugging without exposing secrets",
        "Different handling for transient vs permanent errors"
      ],
      "anti_patterns": [
        "No timeout (hangs indefinitely on slow responses)",
        "Infinite retries (amplifies problems)",
        "No backoff (hammers failing service)",
        "Exposing internal errors to users",
        "Logging sensitive data (API keys, PII)",
        "Same retry strategy for all error types"
      ],
      "quality_markers": [
        "Timeout on every external call",
        "Exponential backoff implemented",
        "Circuit breaker for cascading failures",
        "Proper error classification (transient/permanent)",
        "User-friendly error messages",
        "Comprehensive logging for debugging"
      ],
      "example_config": {
        "timeout": 30000,
        "maxRetries": 3,
        "retryDelay": [1000, 2000, 4000],
        "circuitBreaker": {
          "failureThreshold": 5,
          "resetTimeout": 60000
        }
      }
    }
  ],
  "version": "1.0",
  "last_updated": "2025-01-13T00:00:00Z",
  "metadata": {
    "total_patterns": 5,
    "categories": ["architecture", "reliability"],
    "coverage": ["multi-agent", "rag", "workflow", "chatbot", "error-handling"]
  }
}
