{
  "name": "BasicObby",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$path": "src/ReplicatedStorage",

      "Remotes": {
        "$className": "Folder",

        "UpdateCheckpoint": {
          "$className": "RemoteEvent"
        },

        "UpdateCoins": {
          "$className": "RemoteEvent"
        },

        "CoinCollected": {
          "$className": "RemoteEvent"
        },

        "PurchaseItem": {
          "$className": "RemoteEvent"
        }
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$path": "src/ServerScriptService"
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$path": "src/StarterPlayer"
    },

    "StarterGui": {
      "$className": "StarterGui",
      "$path": "src/StarterGui",

      "CoinDisplay": {
        "$className": "ScreenGui",
        "$properties": {
          "ResetOnSpawn": false,
          "IgnoreGuiInset": false
        },

        "CoinLabel": {
          "$className": "TextLabel",
          "$properties": {
            "Size": [0.2, 0, 0.08, 0],
            "Position": [0.01, 0, 0.01, 0],
            "BackgroundTransparency": 0.5,
            "BackgroundColor3": [0, 0, 0],
            "TextColor3": [1, 1, 1],
            "TextSize": 24,
            "Font": "GothamBold",
            "Text": "💰 Coins: 0"
          }
        },

        "CoinScript": {
          "$className": "LocalScript",
          "$path": "src/StarterGui/CoinDisplay/CoinLabel.lua"
        }
      },

      "StageCounter": {
        "$className": "ScreenGui",
        "$properties": {
          "ResetOnSpawn": false,
          "IgnoreGuiInset": false
        },

        "StageLabel": {
          "$className": "TextLabel",
          "$properties": {
            "Size": [0.2, 0, 0.08, 0],
            "Position": [0.01, 0, 0.1, 0],
            "BackgroundTransparency": 0.5,
            "BackgroundColor3": [0, 0, 0],
            "TextColor3": [1, 1, 1],
            "TextSize": 24,
            "Font": "GothamBold",
            "Text": "📍 Stage: 0/10"
          }
        },

        "StageScript": {
          "$className": "LocalScript",
          "$path": "src/StarterGui/StageCounter/StageLabel.lua"
        }
      },

      "ShopUI": {
        "$className": "ScreenGui",
        "$properties": {
          "ResetOnSpawn": false,
          "IgnoreGuiInset": false
        },

        "ToggleButton": {
          "$className": "TextButton",
          "$properties": {
            "Size": [0.15, 0, 0.08, 0],
            "Position": [0.85, 0, 0.01, 0],
            "BackgroundColor3": [0.2, 0.6, 0.9],
            "TextColor3": [1, 1, 1],
            "TextSize": 20,
            "Font": "GothamBold",
            "Text": "🛒 Shop"
          }
        },

        "ShopFrame": {
          "$className": "Frame",
          "$properties": {
            "Size": [0.4, 0, 0.6, 0],
            "Position": [0.3, 0, 0.2, 0],
            "BackgroundColor3": [0.1, 0.1, 0.1],
            "BorderSizePixel": 3,
            "BorderColor3": [0.3, 0.3, 0.3],
            "Visible": false
          },

          "Title": {
            "$className": "TextLabel",
            "$properties": {
              "Size": [1, 0, 0.1, 0],
              "Position": [0, 0, 0, 0],
              "BackgroundColor3": [0.2, 0.2, 0.2],
              "TextColor3": [1, 1, 1],
              "TextSize": 28,
              "Font": "GothamBold",
              "Text": "🛒 Shop"
            }
          },

          "ItemContainer": {
            "$className": "ScrollingFrame",
            "$properties": {
              "Size": [1, -20, 0.9, -20],
              "Position": [0, 10, 0.1, 10],
              "BackgroundTransparency": 1,
              "BorderSizePixel": 0,
              "ScrollBarThickness": 8
            }
          }
        },

        "ShopScript": {
          "$className": "LocalScript",
          "$path": "src/StarterGui/ShopUI/ShopFrame.lua"
        }
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FilteringEnabled": true
      },
      "$path": "src/Workspace",

      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Size": [512, 10, 512],
          "Position": [0, -5, 0],
          "BrickColor": "Dark green"
        }
      },

      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Size": [6, 1, 6],
          "Position": [0, 0.5, 0],
          "BrickColor": "Bright blue",
          "Duration": 0,
          "Transparency": 0.5
        }
      }
    }
  }
}
