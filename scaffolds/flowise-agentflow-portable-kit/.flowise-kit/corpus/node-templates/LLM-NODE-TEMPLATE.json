          {
            "label": "Value",
            "name": "value",
            "type": "string",
            "acceptVariable": true,
            "placeholder": "{{ llmOutput }}"
          }
        ],
        "id": "llmAgentflow_0-input-llmStateUpdates-array",
        "display": true
      }
