            "acceptVariable": true,
            "generateInstruction": true,
            "rows": 4,
            "placeholder": "Enter message content or use variables like {{ $flow.state.input }}"
          }
        ],
        "id": "llmAgentflow_0-input-llmMessages-array",
        "display": true
      },
      {
        "label": "Memory",
        "name": "llmMemory",
        "type": "asyncOptions",
        "loadMethod": "listMemories",
        "loadConfig": true,
        "optional": true,
        "description": "Optional: Add conversation memory with configurable window/token settings",
        "id": "llmAgentflow_0-input-llmMemory-asyncOptions",
        "display": true
      },
      {
        "label": "JSON Schema",
        "name": "llmJsonSchema",
        "type": "string",
        "rows": 8,
        "optional": true,
        "acceptVariable": true,
        "placeholder": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"name\": { \"type\": \"string\" },\n    \"age\": { \"type\": \"number\" }\n  },\n  \"required\": [\"name\"]\n}",
