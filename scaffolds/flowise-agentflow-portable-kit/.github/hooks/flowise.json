{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "./.claude/hooks/flowise-pre-write.sh",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "./.claude/hooks/flowise-post-write.sh",
        "cwd": ".",
        "timeoutSec": 120
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "./.claude/hooks/flowise-stop.sh",
        "cwd": ".",
        "timeoutSec": 10
      }
    ]
  }
}
