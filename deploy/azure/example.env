# Context Foundry build service -- Azure deployment env template.
#
# cp deploy/azure/example.env deploy/azure/.env  then edit.
# deploy/azure/deploy.sh sources deploy/azure/.env when it exists.
# Never commit .env -- it is gitignored.

# --- deploy.sh parameters (passed to main.bicep) ---

# Globally unique ACR name (5-50 alphanumeric chars).
ACR_NAME=

# Globally unique Storage account name (3-24 lowercase alphanumeric chars).
STORAGE_ACCOUNT=

# Daemon image reference in ACR. Build it with
# `cargo build --release --features azure` and push before deploying.
SERVICE_IMAGE=myacr.azurecr.io/foundry-service:latest

# Comma-separated /v1 bearer API keys. Empty = fail-closed.
API_KEYS=

# Real Anthropic API key held by the auth proxy.
ANTHROPIC_API_KEY=

# --- Runtime FOUNDRY_SERVICE_AZURE_* surface (FYI) ---
#
# main.bicep wires these onto the Container App; you do not set them here.
# Listed so an operator knows the full Azure runtime config surface. They are
# read only when the binary is built `--features azure` and
# FOUNDRY_SERVICE_BUILD_BACKEND=azure_container_apps.
#
#   FOUNDRY_SERVICE_AZURE_SUBSCRIPTION_ID   (required)
#   FOUNDRY_SERVICE_AZURE_RESOURCE_GROUP    (required)
#   FOUNDRY_SERVICE_AZURE_LOCATION          (required)
#   FOUNDRY_SERVICE_AZURE_STORAGE_ACCOUNT   (required)
#   FOUNDRY_SERVICE_AZURE_STORAGE_KEY       (required, from listKeys() secret)
#   FOUNDRY_SERVICE_AZURE_ACR_NAME          (required)
#   FOUNDRY_SERVICE_AZURE_ACA_ENVIRONMENT   (required)
#   FOUNDRY_SERVICE_AZURE_STORAGE_CONTAINER (optional, default foundry-jobs)
#   FOUNDRY_SERVICE_AZURE_MI_CLIENT_ID      (optional, default system-assigned)
#   FOUNDRY_SERVICE_AZURE_SIGNED_URL_TTL_SECS (optional, default 900)
#   FOUNDRY_SERVICE_AZURE_SAS_GRANT_TTL_SECS  (optional, default 3600)
