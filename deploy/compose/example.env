# Context Foundry build service -- Compose stack env template.
#
# cp deploy/compose/example.env deploy/compose/.env  then edit.
# Never commit .env -- it is gitignored.

# Postgres credentials (consumed by the `postgres` service).
POSTGRES_USER=foundry
POSTGRES_PASSWORD=foundry
POSTGRES_DB=foundry

# Postgres connection string for the service. The hostname `postgres` is the
# Compose service name -- it resolves on the Compose network.
FOUNDRY_SERVICE_DATABASE_URL=postgres://foundry:foundry@postgres:5432/foundry

# Listener bind addresses inside the container.
FOUNDRY_SERVICE_BIND=0.0.0.0:8787
FOUNDRY_SERVICE_PROXY_BIND=0.0.0.0:8788

# Comma-separated bearer API keys. Empty = fail-closed (every protected route
# returns 401). Set at least one key before exposing the service.
FOUNDRY_SERVICE_API_KEYS=

# Build backend: `mock` (default, no real builds) or `local_docker`.
FOUNDRY_SERVICE_BUILD_BACKEND=mock

# Real Anthropic key held by the auth proxy. Required only for non-mock
# backends in the default `api_key` upstream-auth mode.
ANTHROPIC_API_KEY=

# Caddy admin API URL -- the service posts preview routes here.
FOUNDRY_SERVICE_CADDY_ADMIN_URL=http://caddy:2019

# URL builder containers use to reach the auth proxy. Relies on the
# `extra_hosts: host.docker.internal:host-gateway` mapping in the Compose file.
FOUNDRY_SERVICE_BUILDER_PROXY_URL=http://host.docker.internal:8788
